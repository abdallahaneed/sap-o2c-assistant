# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from api.sap.com (log in, open any API, click "Show API Key")
# Leave empty to run in mock mode from data/fixtures
SAP_API_KEY=
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap

# Chat model. Default: a free local model through Ollama (ollama.com).
# Use an instruct model (no slow thinking phase). Pull it once: ollama pull qwen3:4b-instruct
# Runs on 8 GB RAM. With 16 GB or more you can try a larger instruct model.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# Optional, paid: switch LLM_PROVIDER to anthropic and add a key from console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
